{
  "name": "alaqsa",
  "version": "1.0.0",
  "description": "AlAqsa — CCTV shop client & maintenance management (نظام إدارة عملاء وصيانة كاميرات المراقبة)",
  "author": {
    "name": "Areen Abou Fakher",
    "email": "arin.aboufakher@gmail.com",
    "url": "https://github.com/AreenHUB"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.main.json -w",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "postinstall": "electron-builder install-app-deps",
    "package": "npm run build && electron-builder --win --x64",
    "package:dir": "npm run build && electron-builder --win --dir",
    "sign": "powershell -ExecutionPolicy Bypass -File scripts/sign-app.ps1",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^11.5.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "docx": "^8.5.0",
    "pdfmake": "^0.2.10",
    "qrcode": "^1.5.4",
    "jsbarcode": "^3.11.6",
    "bonjour-service": "^1.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "electron-rebuild": "^3.2.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
